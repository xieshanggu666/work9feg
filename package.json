{
  "name": "exam-system",
  "version": "2.0.0",
  "private": true,
  "description": "在线考试与题库管理系统（FastAPI + Vue3 + TS）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "python3 -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "init-db": "python3 scripts/init_db.py",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "python3 -m uvicorn app.main:app --port 8000",
    "test": "pytest tests/ -v"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.63.5"
  }
}
